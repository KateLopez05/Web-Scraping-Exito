# Ignore Python bytecode files
__pycache__/
*.py[cod]
*$py.class

# Ignore packaging/build outputs
build/
dist/
*.egg-info/
.eggs/

# Ignore virtual environments
venv/
env/
.venv/

# Ignore temporary and log files
*.log
*.pot
*.po
*.tmp
*.swp

# Ignore editor and IDE settings
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Keep data files and databases tracked:
# *.csv
# *.json
# *.db
